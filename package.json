{
  "name": "qwinto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "serve": "vite",
    "build": "vite build",
    "check": "pnpm run format.check && pnpm run lint && pnpm run typecheck",
    "format": "biome check --write .",
    "format.check": "biome ci .",
    "lint": "biome lint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^25.6.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.7",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
